# FlashServe-Lite Environment Configuration
# Copy this file to .env and modify as needed

# ── Model ──────────────────────────────────────────────────────────
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
DTYPE=float16

# ── Quantization ───────────────────────────────────────────────────
# Options: fp16, int8, int4
QUANTIZATION=fp16

# ── KV Cache ───────────────────────────────────────────────────────
BLOCK_SIZE=16
NUM_GPU_BLOCKS=8000

# ── Scheduler ──────────────────────────────────────────────────────
MAX_BATCH_SIZE=16
MAX_SEQ_LEN=1024
MAX_NEW_TOKENS=256

# ── Speculative Decoding ───────────────────────────────────────────
ENABLE_SPECULATIVE=false
DRAFT_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
NUM_SPECULATIVE_TOKENS=4

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to true to use only locally cached model files
LOCAL_FILES_ONLY=false
